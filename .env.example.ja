# .env.example.ja (日本語コメント付き)
# このファイルを .env にコピーして、環境に合わせて編集してください
# cp .env.example.ja .env

# ======================
# ネットワーク設定
# ======================
# 外部公開IP（各サービスをこのIPにバインドします）
BIND_IP=127.0.0.1

# 外部公開ポート
WEBUI_PORT=80
OPENVPN_PORT=41194
CERT_API_PORT=8888

# 内部ポート（通常は変更不要）
WEBUI_INTERNAL_PORT=5000
OPENVPN_INTERNAL_PORT=1194
CERT_API_INTERNAL_PORT=8080

# VPNネットワーク設定
VPN_NETWORK=10.8.0.0
VPN_NETMASK=255.255.255.0

# 証明書APIのバインドIP（BIND_IPと同じ値を設定するのが一般的）
CERT_API_BIND_IP=127.0.0.1

# ======================
# 内部ネットワーク設定（オプション）
# ======================
# VPNクライアントからアクセスできる内部ネットワークのサブネットマスク
HOME_NETMASK=255.255.0.0
# VPNクライアントにプッシュする内部DNSドメイン（不要の場合は空欄）
HOME_DOMAIN=
# WindowsネットワークのNetBIOS名前解決を有効にする
ENABLE_NETBIOS=false

# ======================
# ドメイン設定
# ======================
ADMIN_DOMAIN=vpnadmin.example.com
USER_DOMAIN=vpn.example.com
# OpenVPNの接続先（.ovpnファイルに記載されるホスト名）
OPENVPN_REMOTE_HOST=example.com

# ======================
# セキュリティ設定
# ======================
# Flask SECRET_KEY（python3 -c 'import secrets; print(secrets.token_hex(32))' で生成）
SECRET_KEY=xxx

# 証明書API認証シークレット（同様のコマンドで別途生成）
CERT_API_SECRET=xxx

# ======================
# WebUIアクセス制御
# ======================
# WebUI管理者として扱うAD/LDAPグループ（LDAPディレクトリ内のグループ名と一致させること）
ADMIN_GROUP=net-vpn-admins

# ======================
# LDAP認証設定
# ======================
# LDAPサーバー設定
LDAP_SERVER=ldap.example.com
LDAP_PORT=389

# LDAP Base DN（ユーザー検索の起点）
LDAP_BASE_DN=dc=example,dc=com

# LDAP Bindユーザー（検索用アカウント）
LDAP_BIND_USER=CN=BindUser,CN=Users,DC=example,DC=com
LDAP_BIND_PASSWORD=your-bind-password

# LDAP検索フィルター（{username}はユーザー名に置換されます）
# Active Directory向けのデフォルト設定
LDAP_USER_FILTER=(&(objectClass=user)(|(sAMAccountName={username})(userPrincipalName={username})))

# VPNアクセス許可グループ（このグループのメンバーのみVPN接続を許可）
LDAP_VPN_GROUP=CN=VPN-Users,CN=Users,DC=example,DC=com

# ======================
# 証明書・CA設定
# ======================
# CA証明書情報
EASYRSA_REQ_COUNTRY=JP
EASYRSA_REQ_PROVINCE=Tokyo
EASYRSA_REQ_CITY=Tokyo
EASYRSA_REQ_ORG=VPN-Server
EASYRSA_REQ_EMAIL=admin@example.com
EASYRSA_REQ_OU=VPN
EASYRSA_CA_CN=VPN-CA

# クライアント証明書情報
EASYRSA_CLIENT_OU=VPN-Client

# 証明書の有効期限（日）
EASYRSA_CA_EXPIRE=3650
EASYRSA_CERT_EXPIRE=825
# 警告: CRLは証明書失効操作時にしか再生成されず、定期更新の仕組みはありません。
# 値が短すぎると（例: 180日）、最後の失効操作から指定日数が経過した時点でCRLが期限切れとなり、
# 有効な証明書を持つクライアントも含め「VERIFY ERROR: CRL has expired」で全員接続不能になります。
# 長い値（3650 = 約10年）を設定して予期せぬ期限切れを防いでください。
EASYRSA_CRL_DAYS=3650

# ======================
# パス設定（通常は変更不要）
# ======================
EASYRSA_VERSION=3.2.1

# ======================
# Flask設定
# ======================
FLASK_ENV=production

# ======================
# ログ設定
# ======================
# ログローテーション方法（size: サイズ毎, time: 日付毎）
LOG_ROTATION_TYPE=time
# サイズローテーションの場合の最大サイズ（MB）
LOG_MAX_SIZE_MB=10
# 保持する世代数
LOG_BACKUP_COUNT=30
# 時間ローテーションの場合の間隔（D: 日, W: 週, M: 月）
LOG_ROTATION_WHEN=D
# 時間ローテーションの場合のインターバル（Dの場合、1で毎日、7で7日毎）
LOG_ROTATION_INTERVAL=1

# ======================
# ダウンロード有効期限設定
# ======================
# 承認されてからの有効期限（時間、0=無制限）
DOWNLOAD_EXPIRE_FROM_APPROVAL_HOURS=24
# 初回ダウンロードからの有効期限（時間、0=即時無効）
DOWNLOAD_EXPIRE_FROM_FIRST_DOWNLOAD_HOURS=0

# ======================
# VPNログ解析スケジューラ設定
# ======================
# スケジュールモード（INTERVAL: N分毎, FIXED: 指定時刻）
VPN_LOG_SCHEDULE_MODE=FIXED
# INTERVALモードの場合の実行間隔（分）
VPN_LOG_SCHEDULE_INTERVAL=15
# FIXEDモードの場合の実行時刻（カンマ区切り, 0-59）
VPN_LOG_SCHEDULE_TIMES=0,15,30,45
# 処理タイムアウト（秒）
VPN_LOG_PARSER_TIMEOUT=300
