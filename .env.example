# .env.example
# Copy this file to .env and edit it for your environment
# cp .env.example .env

# ======================
# Network Settings
# ======================
# External public IP (bind services to this IP)
BIND_IP=127.0.0.1

# External public ports
WEBUI_PORT=80
OPENVPN_PORT=41194
CERT_API_PORT=8888

# Internal ports (usually no need to change)
WEBUI_INTERNAL_PORT=5000
OPENVPN_INTERNAL_PORT=1194
CERT_API_INTERNAL_PORT=8080

# VPN Network Settings
VPN_NETWORK=10.8.0.0
VPN_NETMASK=255.255.255.0

# Certificate API bind IP (IP the cert API listens on; typically same as BIND_IP)
CERT_API_BIND_IP=127.0.0.1

# ======================
# Internal Network Settings (optional)
# ======================
# Internal network reachable from VPN clients
HOME_NETMASK=255.255.0.0
# Internal DNS domain pushed to VPN clients (optional, leave empty to disable)
HOME_DOMAIN=
# Enable NetBIOS name resolution for Windows networks
ENABLE_NETBIOS=false
# Route all client traffic through the VPN (internet exits from this server).
# false = only HOME_NETWORK is routed (split tunnel)
FULL_TUNNEL=false

# ======================
# Domain Settings
# ======================
# Leave ADMIN_DOMAIN empty to serve everything on one domain (admin portal under /admin).
# Set both to serve the admin portal on its own domain (see docs/CONFIGURATION.md).
ADMIN_DOMAIN=
USER_DOMAIN=
# OpenVPN connection destination (hostname written in .ovpn file)
OPENVPN_REMOTE_HOST=example.com

# ======================
# Security Settings
# ======================
# Flask SECRET_KEY (generate with: python3 -c 'import secrets; print(secrets.token_hex(32))')
SECRET_KEY=xxx

# Certificate API authentication secret (generate separately with the same command)
CERT_API_SECRET=xxx

# ======================
# WebUI Access Control
# ======================
# AD/LDAP group whose members are treated as WebUI administrators
# (must match the group DN in your LDAP directory)
ADMIN_GROUP=net-vpn-admins

# IP address(es) of the reverse proxy that injects Remote-User / Remote-Groups
# (comma-separated IPs or CIDRs). Requests from any other source are treated as unauthenticated,
# so a host on the internal network cannot forge the headers. Strongly recommended.
TRUSTED_PROXIES=192.0.2.10

# ======================
# LDAP Authentication Settings
# ======================
# LDAP server settings
LDAP_SERVER=ldap.example.com
LDAP_PORT=389

# LDAP Base DN (base for user search)
LDAP_BASE_DN=dc=example,dc=com

# LDAP Bind User (account for searching)
LDAP_BIND_USER=CN=BindUser,CN=Users,DC=example,DC=com
LDAP_BIND_PASSWORD=your-bind-password

# LDAP search filter ({username} is replaced with the user name)
# Default settings for Active Directory
LDAP_USER_FILTER=(&(objectClass=user)(|(sAMAccountName={username})(userPrincipalName={username})))

# VPN access permission group (only members of this group can connect to VPN)
LDAP_VPN_GROUP=CN=VPN-Users,CN=Users,DC=example,DC=com

# CA certificate (PEM) of the LDAP server, to verify it during StartTLS (optional).
# Empty = encrypted but unverified. Place the file under data/certs/ and give the
# container path, e.g. /etc/openvpn/ldap-ca.pem. LDAP_SERVER must then be the host
# name in the server certificate (an IP address will not match).
LDAP_TLS_CA_FILE=

# ======================
# Certificate and CA Settings
# ======================
# CA Certificate Information
EASYRSA_REQ_COUNTRY=JP
EASYRSA_REQ_PROVINCE=Tokyo
EASYRSA_REQ_CITY=Tokyo
EASYRSA_REQ_ORG=VPN-Server
EASYRSA_REQ_EMAIL=admin@example.com
EASYRSA_REQ_OU=VPN
EASYRSA_CA_CN=VPN-CA

# Client Certificate Information
EASYRSA_CLIENT_OU=VPN-Client

# Certificate validity (days)
EASYRSA_CA_EXPIRE=3650
EASYRSA_CERT_EXPIRE=825
# WARNING: CRL is only regenerated when a certificate is revoked (no periodic renewal).
# If this value is too short (e.g. 180 days), the CRL will expire and ALL clients will
# be blocked with "VERIFY ERROR: CRL has expired" — even clients with valid certificates.
# Set to a long value (3650 = ~10 years) to prevent silent expiry.
EASYRSA_CRL_DAYS=3650

# ======================
# Path Settings (usually no need to change)
# ======================
EASYRSA_VERSION=3.2.1

# ======================
# Flask Settings
# ======================
FLASK_ENV=production

# ======================
# Log Settings
# ======================
# Log rotation method (size: by size, time: by date)
LOG_ROTATION_TYPE=time
# Max size in MB for size-based rotation
LOG_MAX_SIZE_MB=10
# Number of generations to keep
LOG_BACKUP_COUNT=30
# Rotation interval for time-based rotation (D: day, W: week, M: month)
LOG_ROTATION_WHEN=D
# Interval for time-based rotation (e.g., 1 for daily, 7 for every 7 days with D)
LOG_ROTATION_INTERVAL=1

# ======================
# Download Expiration Settings
# ======================
# Expiration time from approval (hours, 0=unlimited)
DOWNLOAD_EXPIRE_FROM_APPROVAL_HOURS=24
# Expiration time from first download (hours, 0=disable immediately)
DOWNLOAD_EXPIRE_FROM_FIRST_DOWNLOAD_HOURS=0

# ======================
# VPN Log Analysis Scheduler Settings
# ======================
# Schedule mode (INTERVAL: every N minutes, FIXED: at specific times)
VPN_LOG_SCHEDULE_MODE=FIXED
# Execution interval in minutes for INTERVAL mode
VPN_LOG_SCHEDULE_INTERVAL=15
# Execution times for FIXED mode (comma-separated, 0-59)
VPN_LOG_SCHEDULE_TIMES=0,15,30,45
# Processing timeout (seconds)
VPN_LOG_PARSER_TIMEOUT=300
